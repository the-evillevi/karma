{
  "name": "karma-pos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Karma POS — punto de venta para cafetería (Vite + React)",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:domain": "vitest run src/domain",
